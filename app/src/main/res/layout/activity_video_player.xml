<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/playerBack" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/background" app:title="@string/player_title"
        app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp"
        android:text="@string/player_url_hint" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <EditText android:id="@+id/videoUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:singleLine="true" android:inputType="textUri"
        android:hint="https://example.com/video.mp4" android:padding="12dp"
        android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/outline" />
    <com.google.android.material.button.MaterialButton android:id="@+id/playUrlButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp"
        android:text="@string/player_play_url" app:icon="@drawable/ic_play" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp" android:layout_marginBottom="8dp">
        <androidx.media3.ui.PlayerView android:id="@+id/videoPlayerView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="true" app:show_buffering="when_playing" />
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/startPlayerTranslationButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp"
        android:text="@string/player_start_translation" app:icon="@drawable/ic_translate" />
    <TextView android:id="@+id/videoPlayerStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:gravity="center" android:text="@string/player_idle"
        android:textColor="@color/text_secondary" android:textSize="13sp" />
</LinearLayout>
