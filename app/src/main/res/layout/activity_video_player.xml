<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/playerBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background" app:title="@string/player_title" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back"/>
<EditText android:id="@+id/videoUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:singleLine="true" android:inputType="textUri" android:hint="https://example.com/video.mp4"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/subtitleUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:hint="@string/player_subtitle_url"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/drmLicenseUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:hint="@string/player_drm_license_url"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/playUrlButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="@string/player_play_url"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><androidx.media3.ui.PlayerView android:id="@+id/videoPlayerView" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="true" app:show_buffering="when_playing"/><TextView android:id="@+id/liveSubtitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginHorizontal="20dp" android:layout_marginBottom="30dp" android:gravity="center" android:textAlignment="center" android:textDirection="anyRtl" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:shadowColor="#FF000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="4" android:background="@android:color/transparent" android:visibility="gone"/></FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp"><com.google.android.material.button.MaterialButton android:id="@+id/loadSubtitleButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/player_load_subtitle"/><com.google.android.material.button.MaterialButton android:id="@+id/openSourceButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/player_open_source"/></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/startPlayerTranslationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="@string/player_start_translation"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp"><com.google.android.material.button.MaterialButton android:id="@+id/syncVideoButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sync_video"/><com.google.android.material.button.MaterialButton android:id="@+id/calibrateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/calibrate"/><com.google.android.material.button.MaterialButton android:id="@+id/exportSrtButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/export_srt"/></LinearLayout>
<TextView android:id="@+id/videoPlayerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:gravity="center" android:text="@string/player_idle" android:textColor="@color/text_secondary"/>
</LinearLayout>
