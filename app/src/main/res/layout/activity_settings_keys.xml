<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true" android:layoutDirection="locale">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/subpageToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" />
  <TextView android:id="@+id/subpageDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إدارة مزودي الترجمة ومفاتيح API. لا تشارك المفاتيح مع الآخرين." android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="10dp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="مزوّد التعرّف على الكلام (STT)" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_primary" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اختر الخدمة التي تستمع إلى الصوت وتحوله إلى نص. هذا الاختيار مستقل عن مزوّد الترجمة." android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/sttProviderUnifiedLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/sttProviderUnifiedSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="مزوّد التعرّف على الكلام" android:inputType="none" />
  </com.google.android.material.textfield.TextInputLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="مفاتيح الخدمات" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_primary" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="احفظ مفاتيحك هنا مرة واحدة. يُستخدم مفتاح Groq مع Whisper عند اختياره، ومفتاح Deepgram مع Nova-2 أو Nova-3." android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/providerSpinnerLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/providerSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="مزوّد الترجمة" android:inputType="text" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/groqKeyInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/groqKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Groq API Key" android:inputType="textPassword" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/deepgramKeyUnifiedLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline" app:endIconMode="password_toggle">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/deepgramKeyUnifiedInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Deepgram API Key" android:inputType="textPassword" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/getDeepgramKeyUnifiedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="الحصول على مفتاح Deepgram" />
  <com.google.android.material.button.MaterialButton android:id="@+id/testDeepgramKeyUnifiedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="اختبار اتصال Deepgram" />
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/openAiKeyUnifiedLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline" app:endIconMode="password_toggle">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/openAiKeyUnifiedInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="OpenAI API Key (اختياري)" android:inputType="textPassword" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/omniRouteKeyUnifiedLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline" app:endIconMode="password_toggle">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/omniRouteKeyUnifiedInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="OmniRoute API Key (اختياري)" android:inputType="textPassword" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/getGroqKeyButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="الحصول على مفتاح Groq" />
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/translationKeyInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/translationKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Google Cloud Translation API Key (إذا اخترت Google)" android:inputType="textPassword" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/myMemoryEmailInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/myMemoryEmailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="MyMemory Email" android:inputType="textEmailAddress" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/saveKeysButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="حفظ المفاتيح" />
 </LinearLayout>
</ScrollView>