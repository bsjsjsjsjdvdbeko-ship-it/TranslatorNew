<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/source_language" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/sourceLanguageInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="auto"/></com.google.android.material.textfield.TextInputLayout>
