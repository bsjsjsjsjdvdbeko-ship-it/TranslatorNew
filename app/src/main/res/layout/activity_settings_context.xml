<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true" android:layoutDirection="locale">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/subpageToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:titleTextColor="@color/text_primary" app:navigationIcon="@drawable/ic_arrow_back" />
  <TextView android:id="@+id/subpageDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحكم في الترجمة السياقية وذاكرة الترجمة وقاموس المصطلحات." android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="10dp" />
  <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/contextAwareSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="استخدام الترجمة السياقية" android:layout_marginTop="10dp" />
  <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/translationMemorySwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تفعيل ذاكرة الترجمة" />
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/glossaryInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/glossaryInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="قاموس المصطلحات" android:inputType="textMultiLine" android:minLines="3" android:gravity="top|start" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout android:id="@+id/contextPromptInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/contextPromptInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="تعليمات السياق الإضافية" android:inputType="textMultiLine" android:minLines="3" android:gravity="top|start" />
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/saveContextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="حفظ إعدادات السياق" />
 </LinearLayout>
</ScrollView>